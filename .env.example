# Configuracion para DESARROLLO LOCAL (emulador Firebase).
# Copiá este archivo como ".env" (sin el sufijo .example) en la raiz del proyecto.
# La API key es ficticia de proposito: con VITE_USE_EMULATOR=true todas las
# llamadas van al emulador local y NO se toca la base real de produccion.
VITE_FIREBASE_API_KEY=AIzaSyDemoDemoDemoDemoDemoDemoDemoDemo
VITE_FIREBASE_AUTH_DOMAIN=localhost
VITE_FIREBASE_PROJECT_ID=glamours-control
VITE_FIREBASE_STORAGE_BUCKET=glamours-control.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=1
VITE_FIREBASE_APP_ID=1
VITE_USE_EMULATOR=true